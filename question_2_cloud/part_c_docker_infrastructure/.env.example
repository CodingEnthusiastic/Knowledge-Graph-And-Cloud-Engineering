# CareSync AI Production Environment Configuration Example
# Copy to .env and replace with secure values

# Application Environment
APP_ENV=production
DOMAIN_NAME=app.example.in
LETSENCRYPT_EMAIL=admin@example.in

# PostgreSQL Database Secrets
POSTGRES_USER=app_user
POSTGRES_PASSWORD=ChangeThisToAStrongRandomSecret_98471
POSTGRES_DB=app_db
DATABASE_URL=postgresql://app_user:ChangeThisToAStrongRandomSecret_98471@postgres:5432/app_db

# Redis Message Broker
REDIS_URL=redis://redis:6379/0

# AI Service Configuration
AI_SERVICE_URL=http://ai-service:8001
MODEL_NAME=llama-3.1-8b-instruct
QUANTIZATION=4bit

# Offsite Backup Credentials (Cloudflare R2 / S3-compatible)
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=caresync-production-backups
R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
